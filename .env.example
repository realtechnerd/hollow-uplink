# Copy to .env and fill in. Local dev defaults point at dev/broker.py or docker compose.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set to 1 for HiveMQ Cloud / EMQX Cloud (port 8883)
MQTT_TLS=0

# Which site this machine is. Each teammate uses their own, e.g. gw-va, gw-tx.
GATEWAY_ID=gw-local
